###############################################################################
# hello-service — Cloud Run v2 example
# Generated by Tech Design AI run 2026-05-06T1042-Kx7nP3
#
# Hard rules honoured:
#   * No Service Account JSON keys (Workload Identity Federation only).
#   * VPC + Artifact Registry are referenced as data sources, never created here.
#   * No `terraform apply` from CI — this directory is opened as a PR only.
###############################################################################

provider "google" {
  project = var.project_id
  region  = var.region
}

# --- Existing resources, referenced (not created) ----------------------------

data "google_compute_network" "vpc" {
  name    = var.vpc_network_name
  project = var.project_id
}

data "google_artifact_registry_repository" "apps" {
  project       = var.project_id
  location      = var.region
  repository_id = var.artifact_registry_repo
}

# --- Service account ---------------------------------------------------------

resource "google_service_account" "hello_run" {
  project      = var.project_id
  account_id   = "hello-run-sa"
  display_name = "Hello Service runtime SA"
  description  = "Runtime identity for the hello-service Cloud Run v2 service."
}

resource "google_project_iam_member" "hello_logging" {
  project = var.project_id
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:${google_service_account.hello_run.email}"
}

resource "google_project_iam_member" "hello_monitoring" {
  project = var.project_id
  role    = "roles/monitoring.metricWriter"
  member  = "serviceAccount:${google_service_account.hello_run.email}"
}

resource "google_project_iam_member" "hello_trace" {
  project = var.project_id
  role    = "roles/cloudtrace.agent"
  member  = "serviceAccount:${google_service_account.hello_run.email}"
}

# --- Cloud Run v2 service ----------------------------------------------------

resource "google_cloud_run_v2_service" "hello" {
  name     = "hello-service"
  project  = var.project_id
  location = var.region
  ingress  = "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER"
  labels   = var.labels

  template {
    service_account                  = google_service_account.hello_run.email
    execution_environment            = "EXECUTION_ENVIRONMENT_GEN2"
    timeout                          = "60s"
    max_instance_request_concurrency = 80

    scaling {
      min_instance_count = 1
      max_instance_count = 2
    }

    containers {
      image = var.image

      resources {
        cpu_idle = false # cpu_always_allocated == NOT idle
        limits = {
          cpu    = "1"
          memory = "256Mi"
        }
      }

      ports {
        container_port = 8080
      }

      startup_probe {
        initial_delay_seconds = 1
        period_seconds        = 5
        failure_threshold     = 3
        tcp_socket {
          port = 8080
        }
      }
    }
  }

  depends_on = [
    google_project_iam_member.hello_logging,
    google_project_iam_member.hello_monitoring,
    google_project_iam_member.hello_trace,
  ]
}

# --- IAM: only the named invoker SA may call /hello --------------------------

resource "google_cloud_run_v2_service_iam_member" "invoker" {
  count    = var.invoker_sa == "" ? 0 : 1
  project  = var.project_id
  location = google_cloud_run_v2_service.hello.location
  name     = google_cloud_run_v2_service.hello.name
  role     = "roles/run.invoker"
  member   = "serviceAccount:${var.invoker_sa}"
}

# --- Observability: log-based metric + uptime check --------------------------

resource "google_logging_metric" "hello_world_lines" {
  project = var.project_id
  name    = "hello_service_hello_world_lines"
  filter  = <<-EOT
    resource.type="cloud_run_revision"
    resource.labels.service_name="${google_cloud_run_v2_service.hello.name}"
    textPayload:"hello world"
  EOT

  metric_descriptor {
    metric_kind = "DELTA"
    value_type  = "INT64"
    unit        = "1"
  }
}

resource "google_monitoring_uptime_check_config" "hello" {
  project      = var.project_id
  display_name = "hello-service-uptime"
  timeout      = "10s"
  period       = "60s"

  http_check {
    path           = "/hello"
    port           = "443"
    use_ssl        = true
    validate_ssl   = true
    request_method = "GET"
  }

  monitored_resource {
    type = "uptime_url"
    labels = {
      project_id = var.project_id
      host       = replace(google_cloud_run_v2_service.hello.uri, "https://", "")
    }
  }
}
